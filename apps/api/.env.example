APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# AdminUserSeeder (php artisan db:seed) — đổi mật khẩu trên production
ADMIN_NAME="Site Admin"
ADMIN_EMAIL=admin@english-zero2hero.local
ADMIN_PASSWORD=password

GOOGLE_OAUTH_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"

AI_PROVIDER=stub
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Grammar translate & analyze (overridable in Admin → Integrations → Grammar tool)
GRAMMAR_TOOL_ENABLED=true
GRAMMAR_TOOL_GUEST_DAILY=10
GRAMMAR_TOOL_USER_DAILY=50
GRAMMAR_TOOL_LIBRETRANSLATE_ENABLED=true
GRAMMAR_TOOL_LIBRETRANSLATE_URL=https://libretranslate.com/translate
GRAMMAR_TOOL_LIBRETRANSLATE_API_KEY=
GRAMMAR_TOOL_LIBRETRANSLATE_TIMEOUT=12
GRAMMAR_TOOL_MYMEMORY_FALLBACK=true
# Optional — raises MyMemory daily quota when set
GRAMMAR_TOOL_MYMEMORY_CONTACT_EMAIL=
GRAMMAR_TOOL_MYMEMORY_TIMEOUT=12

E2H_CRAWL_WHITELIST=

# Grammar group quiz (questions per session + JSON feeds)
GRAMMAR_GROUP_QUIZ_LIMIT=15
GRAMMAR_GROUP_QUIZ_MAX=30
# Prefer Admin → Content → Questions → feeds (grammar_question_feeds table).
# Legacy: comma-separated JSON feed URLs (host must be in E2H_CRAWL_WHITELIST)
GRAMMAR_QUESTION_FEED_URLS=
# Defaults to packages/content/quiz-questions.json when unset
# GRAMMAR_QUESTION_FEED_LOCAL=
# Comma-separated filenames under packages/content/ (default: quiz-questions.json,quiz-questions-bank.json)
# GRAMMAR_QUESTION_FEED_LOCAL_PATHS=quiz-questions.json,quiz-questions-bank.json
# Regenerate bank: php packages/content/bin/generate-quiz-bank.php
# Crawl HTTP client (see docs/GRAMMAR_QUESTION_CRAWL.md)
GRAMMAR_CRAWL_DELAY_MS=500
GRAMMAR_CRAWL_TIMEOUT=30
GRAMMAR_CRAWL_USER_AGENT="EnglishZero2Hero/1.0 (+grammar-quiz-crawl)"
